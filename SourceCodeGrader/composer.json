{
    "name": "autonomo/source-code-grader",
    "description": "A quick and easy standard PHP skeleton.",
    "keywords": [
        "llm",
        "ai agent",
        "AI"
    ],
    "homepage": "https://www.phpexperts.pro/",
    "license": "MIT",
    "authors": [
        {
            "name": "Autonomous Programming, LLC.",
            "homepage": "https://www.autonomo.codes/"
        },
        {
            "name": "Theodore R. Smith",
            "homepage": "https://www.linkedin.com/in/tedrsmith"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "phpexperts/chatgpt-speaker": "^1.2",
        "phpexperts/laravel-env-polyfill": "^1.7"
    },
    "require-dev": {
        "phpunit/phpunit": "12.*",
        "phpstan/phpstan": "*",
        "friendsofphp/php-cs-fixer": "*",
        "symfony/var-dumper": "*",
        "squizlabs/php_codesniffer": "*"
    },
    "autoload": {
        "psr-4": {
            "Autonomo\\SourceCodeGrader\\" : "src/"
        }
    },
    "autoload-dev": {
        "psr-4": { "Autonomo\\SourceCodeGrader\\Tests\\" : "tests/" }
    },
    "config": {
        "classmap-authoritative": true,
        "allow-plugins": {
            "0.0.0/composer-include-files": true
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "PHP_VERSION=native php install.php"
        ]
    },
    "repositories": [
        { "type": "path", "url": "/code/ChatGPTSpeaker", "options": { "symlink": true } }
    ]
}
